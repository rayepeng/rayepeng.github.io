# Remark42 运行参数模板。
# 实际文件由 setup-remark42.sh 生成到 /etc/remark42.env（已存在则不会覆盖）。
# 改完执行:  sudo systemctl restart remark42

# ── 必填 ──────────────────────────────────────────────────────────────
# 对外访问地址（经 Cloudflare Tunnel 暴露）
REMARK_URL=https://comments.rayepeng.net
# 站点 ID，前端 remark_config.site_id 必须与此一致
SITE=blog
# JWT 签名密钥，脚本首次安装时自动生成强随机值
SECRET=__GENERATED_BY_SETUP_SCRIPT__

# ── 网络：只监听本机，外部只能通过 Cloudflare Tunnel 进来 ──────────────
# ADDRESS 只填主机/IP（不带端口），端口由 REMARK_PORT 指定
REMARK_ADDRESS=127.0.0.1
REMARK_PORT=8080
# cloudflared 从本机回源，信任它带来的 X-Forwarded-For（限流/投票去重需要真实 IP）
TRUSTED_PROXY=127.0.0.1
TIME_ZONE=Asia/Shanghai

# ── 存储（bolt 单文件库 + 自动备份）──────────────────────────────────
STORE_TYPE=bolt
STORE_BOLT_PATH=/opt/remark42/var/db
BACKUP_PATH=/opt/remark42/var/backup

# ── 登录方式 ─────────────────────────────────────────────────────────
# 匿名评论：禁用（只允许 GitHub / Telegram 登录）
AUTH_ANON=false

# GitHub 登录：到 https://github.com/settings/developers 新建 OAuth App
#   Homepage URL           = https://rayepeng.net
#   Authorization callback = https://comments.rayepeng.net/auth/github/callback
# 填好 client id/secret 后取消注释并 systemctl restart remark42
#AUTH_GITHUB_CID=你的ClientID
#AUTH_GITHUB_CSEC=你的ClientSecret

# Telegram 登录：找 @BotFather 建 bot 拿到 token，并执行 /setdomain 绑定
#   https://comments.rayepeng.net
#AUTH_TELEGRAM=true
#TELEGRAM_TOKEN=123456:ABC-DEF...

# Email 登录：需要 SMTP 发验证邮件
#AUTH_EMAIL_ENABLE=true
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=comments@rayepeng.net
#SMTP_TLS=true

# ── 管理员（可删除/编辑任意评论、后台 /web/uml 免审）───────────────────
# 格式为 provider_用户数字ID，如 github_12345678。
# 登录一次后访问 https://comments.rayepeng.net/api/v1/user 可看到自己的 id。
#ADMIN_SHARED_ID=github_12345678
#ADMIN_SHARED_EMAIL=you@example.com

# ── 体验项 ───────────────────────────────────────────────────────────
EMOJI=true
# 低分评论自动折叠阈值（默认 -5 / -10）
#LOW_SCORE=-5
#CRITICAL_SCORE=-10
